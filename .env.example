# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PLATFORM_OWNER_EMAIL: Optional comma-separated administrator email(s) elevated
# to PLATFORM_OWNER on startup/login for multi-tenant platform governance.
PLATFORM_OWNER_EMAIL=""

# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET: Required only when enabling live
# commercial subscription billing checkout & webhook verification.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Persistent Production Database (Required on Vercel / Serverless Deployments)
# ------------------------------------------------------------------------------
# Option A (Recommended): Managed PostgreSQL (Neon, Supabase, Vercel Postgres, RDS)
# DATABASE_URL="postgresql://user:password@host:5432/churnsight?sslmode=require"
# (Also accepts POSTGRES_URL, POSTGRES_PRISMA_URL, or POSTGRES_URL_NON_POOLING)

# Option B: Upstash Redis / Vercel KV REST API
# KV_REST_API_URL="https://your-db.upstash.io"
# KV_REST_API_TOKEN="your-upstash-rest-token"
# (Also accepts UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN)

# Option C: Standalone Node.js hosting only (non-Vercel writable disk directory)
# CHURNSIGHT_DATA_DIR="./.data"

# Optional: Set VITE_API_BASE_URL in Vercel only if hosting the Express backend separately
# VITE_API_BASE_URL="https://your-backend.onrender.com"
# ALLOWED_ORIGINS="https://your-app.vercel.app"
